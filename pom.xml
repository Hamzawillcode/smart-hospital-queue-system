<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only: lets you build everything (or one service plus the
  shared events module) with a single command, e.g.
    mvn -pl queue-service -am verify
  Each service still inherits from spring-boot-starter-parent itself.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hospital</groupId>
    <artifactId>hospital-queue-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>common-events</module>
        <module>eureka-server</module>
        <module>api-gateway</module>
        <module>patient-service</module>
        <module>queue-service</module>
        <module>doctor-service</module>
        <module>notification-service</module>
        <module>monitor-service</module>
    </modules>
</project>
