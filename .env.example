# Copy to .env (git-ignored) and replace EVERY value.
# Used by docker compose, and imported by each service when run from the IDE
# (spring.config.import=optional:file:.env[.properties]).

# HS256 signing key shared by all services: at least 32 random bytes,
# e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# MySQL (docker compose creates one user per service)
MYSQL_ROOT_PASSWORD=replace-me-root
PATIENT_DB_PASSWORD=replace-me-patient
QUEUE_DB_PASSWORD=replace-me-queue
DOCTOR_DB_PASSWORD=replace-me-doctor

# Staff logins issued by patient-service (users: admin, reception, doctor)
ADMIN_PASSWORD=replace-me-admin
STAFF_PASSWORD=replace-me-reception
DOCTOR_PASSWORD=replace-me-doctor-login

# Only used when running services from the IDE:
# 3307 = MySQL from docker compose, 3306 = your own local MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307

HOSPITAL_TIME_ZONE=Asia/Kolkata
